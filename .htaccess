
Options -Indexes


# Route this domain through Laravel's public directory.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^(?:www\.)?nasenyijewishcommunity\.or\.ug(?::[0-9]+)?$ [NC]
    RewriteRule ^(?!public(?:/|$)|\.well-known/(?:acme-challenge|pki-validation)(?:/|$))(.*)$ public/$1 [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
